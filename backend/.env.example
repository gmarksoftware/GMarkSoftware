# --- Server ---
PORT=3000
FRONTEND_URL=https://www.gramgurufoudation.com,https://gramgurufoudation.com,https://www.gramgurufoundation.com,https://gramgurufoundation.com,http://localhost:3001,http://localhost:5173

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
# true = TypeORM auto-creates/updates tables (fine for first run & development).
# For production set false and use migrations.
DB_SYNC=true

# --- Admin login ---
# The admin signs in on the normal website login page (/login) with these credentials.
# The account is created automatically when the backend starts. Change ADMIN_PASSWORD here and restart to reset it.
ADMIN_EMAIL=admin@gramguru.org
ADMIN_PASSWORD=Admin123

# Secret used to sign login tokens. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-another-long-random-string

# Optional legacy key for scripts/curl (header "x-admin-key"). The website does not use it any more.
ADMIN_API_KEY=change-me-to-a-long-random-string

# --- SMTP / Real-Time Email Configuration ---
# Required on Render for sending newsletter and subscriber emails.
# For Gmail, set SMTP_USER to your Gmail and SMTP_PASS to an App Password (https://myaccount.google.com/apppasswords).
# You can also use Brevo, SendGrid, Mailgun, or any standard SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=gramguru2301@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="GramGuru Foundation" <gramguru2301@gmail.com>

# --- AWS S3 File Storage (Production Storage) ---
# In development, files are saved locally to /uploads/. In production, files are stored on AWS S3.
NODE_ENV=development
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=gramguru-assets
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
